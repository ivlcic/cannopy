@inproceedings{ivacic2024comparing,
    title = "Comparing News Framing of Migration Crises using Zero-Shot Classification",
    author = "Iva{\v{c}}i{\v{c}}, Nikola  and
      Purver, Matthew  and
      Lind, Fabienne  and
      Pollak, Senja  and
      Boomgaarden, Hajo  and
      Bajt, Veronika",
